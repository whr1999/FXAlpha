# Copy this file to %h/.config/fxalpha/runtime.env and set mode 0600.
# Keep credentials and machine-specific paths out of the repository.
FXALPHA_CONFIG_FILE=/home/USER/.config/fxalpha/config.yaml
QUANTGPT_REPORTS_DIR=/home/USER/fxalpha-state/quantgpt/reports
QUANTGPT_RESEARCH_NOTES_DIR=/home/USER/fxalpha-state/quantgpt/research_notes
DATABASE_URL=sqlite+aiosqlite:////home/USER/fxalpha-state/quantgpt/quantgpt.db

# Optional provider credentials.
TUSHARE_TOKEN=
FXALPHA_LLM_API_KEY=
FXALPHA_LLM_BASE_URL=
