[Unit]
Description=FXAlpha release governed Tushare data-foundation daily update
After=network-online.target
Wants=network-online.target
OnSuccess=fxalpha-paper-fleet-daily.service
StartLimitIntervalSec=6h
StartLimitBurst=8

[Service]
Type=oneshot
WorkingDirectory=%h/fxalpha-deploy/current
EnvironmentFile=%h/.config/fxalpha/runtime.env
Environment=PYTHONPATH=%h/fxalpha-deploy/current
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/fxalpha-deploy/current/.venv/bin/python3 %h/fxalpha-deploy/current/cli.py data-daily-routine --target-date auto --timeout-minutes 180
TimeoutStartSec=4h
KillMode=control-group
Nice=5
Restart=on-failure
RestartSec=30min
