[Unit]
Description=FXAlpha local API and GUI on 127.0.0.1:18081
After=network.target fxalpha-quantgpt-8003.service
Wants=fxalpha-quantgpt-8003.service

[Service]
Type=simple
WorkingDirectory=%h/FXAlpha
EnvironmentFile=-%h/.config/fxalpha/fxalpha.env
Environment=FXALPHA_CONFIG_FILE=%h/FXAlpha/config.yaml
Environment=PYTHONPATH=%h/FXAlpha
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/FXAlpha/.venv/bin/python3 %h/FXAlpha/scripts/start_fxalpha_api_18081.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM

[Install]
WantedBy=fxalpha-factor-stack.target
