# Prefer a protected config file over putting tokens in the environment.
FXALPHA_CONFIG_FILE=./config.yaml

# Optional Tushare fallback when config.yaml does not contain a token.
TUSHARE_TOKEN=

# Optional LLM provider configuration used by governed research workflows.
FXALPHA_LLM_API_KEY=
FXALPHA_LLM_BASE_URL=
